{
  "compilerOptions": {
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "checkJs": true,
    "paths": {
      "$frizzante/*": [
        "./.frz/utilities/*"
      ],
      "$lib/*": [
        "./lib/*"
      ]
    },
    "lib": [
      "esnext",
      "DOM",
      "DOM.Iterable"
    ],
    "useDefineForClassFields": true,
    "moduleDetection": "force"
  },
  "include": [
    "./router/**/*.svelte.js",
    "./router/**/*.svelte.ts",
    "./router/**/*.svelte",
    "./router/**/*.d.ts",
    "./router/**/*.js",
    "./router/**/*.ts",
    "./utilities/**/*.svelte.js",
    "./utilities/**/*.svelte.ts",
    "./utilities/**/*.svelte",
    "./utilities/**/*.d.ts",
    "./utilities/**/*.js",
    "./utilities/**/*.ts",
    "./lib/**/*.svelte.js",
    "./lib/**/*.svelte.ts",
    "./lib/**/*.svelte",
    "./lib/**/*.d.ts",
    "./lib/**/*.js",
    "./lib/**/*.ts"
  ],
  "exclude": [
    "./node_modules/**"
  ]
}
